# ============================================================================
# FALCON PMS - NGINX DOCKERFILE
# Production Load Balancer for HTTP & WebSockets
# ============================================================================

FROM nginx:1.25-alpine

# Remove default configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom Docker Nginx configuration from config directory
COPY config/nginx.docker.conf /etc/nginx/nginx.conf

# Create static/media fallback mounts
RUN mkdir -p /app/staticfiles /app/media

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
