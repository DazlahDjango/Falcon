# Production Environment
DJANGO_ENV=production
BACKUP_STORAGE_TYPE=s3
BACKUP_S3_BUCKET=falcon-pms-backups-prod
BACKUP_S3_REGION=us-east-1
BACKUP_ENCRYPTION_ENABLED=True
BACKUP_COMPRESSION_ENABLED=True
BACKUP_PARALLEL_WORKERS=8
BACKUP_DEFAULT_RETENTION_DAYS=90
DR_DEFAULT_RTO_MINUTES=240
DR_DEFAULT_RPO_MINUTES=60
DR_AUTO_FAILOVER_ENABLED=True
DR_AUTO_FAILBACK_ENABLED=False
MAINTENANCE_AUTO_APPROVE=False
HEALTH_CONDITIONAL_MAINTENANCE_ENABLED=True
AUDIT_API_ACCESS_ENABLED=True
AUDIT_LOG_RETENTION_DAYS=365
CONFIG_DEBUG=False
STORAGE_ARCHIVE_DAYS=90
STORAGE_DEEP_ARCHIVE_DAYS=365
ENCRYPTION_KEY_ROTATION_DAYS=90
FEATURE_ADVANCED_ANALYTICS=True