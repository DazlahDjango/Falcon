# Stripe Configuration - Get These from https://dashboard.stripe.com/apikeys

# Publishable Key (used on frontend)
STRIPE_PUBLIC_KEY=pk_test_your_key_here

# Secret Key (used on backend - keep private!)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Webhook Signing Secret (from https://dashboard.stripe.com/webhooks)
# Register endpoint: POST /api/billing/webhook/stripe/
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Frontend URL (for Stripe redirects after payment)
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=https://yourdomain.com

# For production Stripe keys, use:
# STRIPE_PUBLIC_KEY=pk_live_your_live_key
# STRIPE_SECRET_KEY=sk_live_your_live_key
