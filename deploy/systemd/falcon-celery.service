[Unit]
Description=Falcon PMS Celery Worker
After=network.target falcon-api.service
Requires=falcon-api.service

[Service]
Type=simple
User=falcon
Group=falcon
WorkingDirectory=/opt/falcon-pms
EnvironmentFile=/opt/falcon-pms/.env.production
Environment=DJANGO_ENV=production
ExecStart=/opt/falcon-pms/fasc/bin/celery -A config worker -l info --concurrency=4
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
